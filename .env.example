# Opcional: por defecto reutiliza mcp_servers.gitlab de ~/.codex/config.toml.
# Las credenciales permanecen en el servidor; no se envían al navegador.
GITLAB_MCP_PATH=../gitlab-mcp/gitlab-mcp
# GITLAB_URL=https://gitlab.example.com
# GITLAB_TOKEN=
# CODEX_CONFIG_PATH=C:/Users/usuario/.codex/config.toml
# COMMIT_EMAILS=otro-correo@example.com
PORT=4173
TZ=America/Montevideo
